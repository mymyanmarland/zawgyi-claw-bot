# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (get it from @userinfobot) — enables /stats and /broadcast
TELEGRAM_OWNER_ID=
# 32-byte hex string for AES-256-GCM encryption of user API keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZAWGYI_MASTER_KEY=
PORT=3012
